const API="https://connectapi.voddic.com.ng/api/v1";
const token=localStorage.getItem("access_token");
const user=JSON.parse(localStorage.getItem("user")||"{}");
const hotel=JSON.parse(localStorage.getItem("hotel")||"{}");
const headers={"Authorization":"Bearer "+token,"Content-Type":"application/json"};
if(!token)window.location.href="/auth/login.html";

var rooms=[],activityLog=[],qrGenerated={};
var maxRooms=5;

document.addEventListener("DOMContentLoaded",function(){
    document.getElementById("userName").textContent=user.full_name||user.email||"Owner";
    document.getElementById("userAvatar").textContent=(user.first_name||"O")[0].toUpperCase();
    document.getElementById("sidebarHotelName").textContent=hotel.name||"Hotel";
    initTabs();
    loadAllData();
});

function initTabs(){
    document.querySelectorAll(".tab-btn[data-tab]").forEach(function(b){
        b.addEventListener("click",function(){
            document.querySelectorAll(".tab-btn").forEach(function(x){x.classList.remove("active");});
            this.classList.add("active");
            document.querySelectorAll(".tab-panel").forEach(function(p){p.classList.remove("active");});
            var panel=document.getElementById("panel-"+this.getAttribute("data-tab"));
            if(panel)panel.classList.add("active");
        });
    });
}

async function loadAllData(){
    await Promise.all([loadRooms(),loadSubscription()]);
    renderAll();
}

async function loadRooms(){
    try{var r=await fetch(API+"/rooms/",{headers:headers});if(r.ok){var d=await r.json();rooms=Array.isArray(d)?d:(d.results||[]);}}catch(e){}
}

async function loadSubscription(){
    try{var r=await fetch(API+"/hotels/subscription/",{headers:headers});if(r.ok){var d=await r.json();maxRooms=d.max_rooms||5;}}catch(e){}
}

function renderAll(){
    renderSummary();
    renderRoomsList();
    renderTypeGrid();
    renderOccupancy();
    renderQRGrid();
    renderMaintenance();
    renderActivityLog();
    populateFilters();
}

function renderSummary(){
    document.getElementById("sumTotal").textContent=rooms.length;
    document.getElementById("sumVacant").textContent=rooms.filter(function(r){return r.status==="AVAILABLE";}).length;
    document.getElementById("sumOccupied").textContent=rooms.filter(function(r){return r.status==="ACTIVE_STAY";}).length;
    document.getElementById("sumMaintenance").textContent=rooms.filter(function(r){return r.status==="MAINTENANCE";}).length;
    document.getElementById("sumDevices").textContent=rooms.filter(function(r){return r.status==="ACTIVE_STAY";}).length;
}

function populateFilters(){
    var floorSel=document.getElementById("filterFloor"),curFloor=floorSel.value;
    var floors=[];rooms.forEach(function(r){if(r.floor&&floors.indexOf(r.floor)===-1)floors.push(r.floor);});
    floors.sort(function(a,b){return a-b;});
    floorSel.innerHTML='<option value="">All Floors</option>'+floors.map(function(f){return'<option value="'+f+'">Floor '+f+'</option>';}).join("");
    floorSel.value=curFloor;
    populateTypeDropdown();
}

function populateTypeDropdown(){
    var sel=document.getElementById("rmType");if(!sel)return;
    var types=[];rooms.forEach(function(r){if(r.room_type&&types.indexOf(r.room_type)===-1)types.push(r.room_type);});
    if(!types.length)types=["Standard","Deluxe","Suite","Executive"];
    var cur=sel.value;
    sel.innerHTML=types.map(function(t){return'<option value="'+t+'"'+(t===cur?' selected':'')+'>'+t+'</option>';}).join("");
}

// ==================== ROOMS LIST ====================
function renderRoomsList(filtered){
    var list=filtered||rooms,grid=document.getElementById("roomsGrid");
    if(!list.length){grid.innerHTML='<div class="empty-state"><p>No rooms found.</p></div>';return;}
    grid.innerHTML=list.map(function(r){
        var sc=r.status==="AVAILABLE"?"rs-vacant":r.status==="ACTIVE_STAY"?"rs-occupied":r.status==="MAINTENANCE"?"rs-maintenance":"rs-inactive";
        var sp=r.status==="AVAILABLE"?"sp-vacant":r.status==="ACTIVE_STAY"?"sp-occupied":r.status==="MAINTENANCE"?"sp-maintenance":"sp-inactive";
        var dc=r.status==="AVAILABLE"?"sp-d-green":r.status==="ACTIVE_STAY"?"sp-d-blue":r.status==="MAINTENANCE"?"sp-d-yellow":"sp-d-gray";
        return'<div class="room-card '+sc+'"><div class="room-header"><div class="room-number">Room '+r.room_number+'</div><span class="room-type-badge">'+(r.room_type||"Standard")+'</span></div>'+
            '<div class="room-details"><div><div class="rd-label">Floor</div><div class="rd-value">'+(r.floor||"—")+'</div></div>'+
            '<div><div class="rd-label">Price</div><div class="rd-value">₦'+(r.price||0)+'</div></div>'+
            '<div><div class="rd-label">Status</div><div class="rd-value"><span class="status-pill '+sp+'"><span class="sp-dot '+dc+'"></span>'+r.status.replace("_"," ")+'</span></div></div></div>'+
            '<div class="room-actions"><button class="btn btn-outline btn-sm" onclick="editRoom(\''+r.id+'\')">Edit</button>'+
            '<button class="btn btn-danger btn-sm" onclick="confirmDeleteRoom(\''+r.id+'\')">Delete</button></div></div>';
    }).join("");
}

function filterRooms(){
    var s=(document.getElementById("roomSearch")?.value||"").toLowerCase();
    var f=document.getElementById("filterFloor")?.value||"";
    var st=document.getElementById("filterStatus")?.value||"";
    renderRoomsList(rooms.filter(function(r){return(!s||(r.room_number||"").toLowerCase().indexOf(s)!==-1)&&(!f||r.floor==parseInt(f))&&(!st||r.status===st);}));
}

// ==================== ROOM CRUD ====================
function openRoomModal(){
    if(rooms.length>=maxRooms){showToast("Room limit reached! "+rooms.length+"/"+maxRooms,"error");return;}
    document.getElementById("roomModalTitle").textContent="Add Room";
    document.getElementById("editRoomId").value="";
    ["rmNumber","rmFloor","rmPrice"].forEach(function(id){document.getElementById(id).value="";});
    document.getElementById("rmStatus").value="AVAILABLE";
    populateTypeDropdown();clearErrors();openModal("roomModal");
}

function editRoom(id){
    var r=rooms.find(function(x){return x.id===id;});if(!r)return;
    document.getElementById("roomModalTitle").textContent="Edit Room";
    document.getElementById("editRoomId").value=r.id;
    document.getElementById("rmNumber").value=r.room_number||"";
    document.getElementById("rmFloor").value=r.floor||"";
    document.getElementById("rmPrice").value=r.price||"";
    document.getElementById("rmStatus").value=r.status||"AVAILABLE";
    populateTypeDropdown();clearErrors();openModal("roomModal");
}

async function saveRoom(){
    clearErrors();var valid=true;
    var editId=document.getElementById("editRoomId").value;
    var number=document.getElementById("rmNumber").value.trim();
    var floor=document.getElementById("rmFloor").value;
    if(!number){showFieldError("rmNumber","errRmNum");valid=false;}
    if(!floor||floor<1){showFieldError("rmFloor","errRmFloor");valid=false;}
    if(!valid)return;
    var body={room_number:number,floor:parseInt(floor),room_type:document.getElementById("rmType").value||"Standard",price:parseFloat(document.getElementById("rmPrice").value)||0,status:document.getElementById("rmStatus").value||"AVAILABLE",is_active:true};
    var url=editId?API+"/rooms/"+editId+"/":API+"/rooms/",method=editId?"PUT":"POST";
    try{
        var res=await fetch(url,{method,headers,body:JSON.stringify(body)});
        if(res.ok){showToast(editId?"Updated!":"Created!","success");closeModal("roomModal");await loadRooms();renderAll();}
        else{var d=await res.json();showToast(d.detail||d.error||"Failed","error");}
    }catch(e){showToast("Network error","error");}
}

function confirmDeleteRoom(id){
    var r=rooms.find(function(x){return x.id===id;});if(!r)return;
    openConfirm("Delete Room "+r.room_number+"?","",async function(){
        try{await fetch(API+"/rooms/"+id+"/",{method:"DELETE",headers});}catch(e){}
        await loadRooms();renderAll();showToast("Deleted","info");
    });
}

// ==================== ROOM TYPES ====================
function renderTypeGrid(){
    var grid=document.getElementById("typeGrid");if(!grid)return;
    grid.innerHTML='<div class="empty-state"><p>Loading...</p></div>';
    fetch(API+"/rooms/types/",{headers:headers}).then(function(r){return r.json();}).then(function(d){
        var types=Array.isArray(d)?d:(d.results||[]);
        if(!types.length){grid.innerHTML='<div class="empty-state"><p>No types yet.</p></div>';return;}
        grid.innerHTML=types.map(function(t){return'<div class="type-card"><div class="type-name">'+t.name+'</div><div class="type-meta">₦'+(t.price||0)+'/night &bull; '+(t.capacity||2)+' guests</div><div style="display:flex;gap:6px;"><button class="btn btn-outline btn-sm" onclick="editType(''+t.id+'')">Edit</button><button class="btn btn-danger btn-sm" onclick="deleteType(''+t.id+'')">Delete</button></div></div>';}).join("");
    }).catch(function(){grid.innerHTML='<div class="empty-state"><p>Error loading types</p></div>';});
}

function deleteType(id){
    openConfirm("Delete this room type?","",async function(){
        try{await fetch(API+"/rooms/types/"+id+"/",{method:"DELETE",headers:headers});}catch(e){}
        renderTypeGrid();showToast("Type deleted","info");
    });
}

function openTypeModal(){document.getElementById("typeModalTitle").textContent="Add Room Type";document.getElementById("editTypeId").value="";["tpName","tpPrice","tpCapacity"].forEach(function(id){document.getElementById(id).value="";});clearErrors();openModal("typeModal");}
function editType(id){fetch(API+"/rooms/types/"+id+"/",{headers:headers}).then(function(r){return r.json();}).then(function(t){document.getElementById("typeModalTitle").textContent="Edit Room Type";document.getElementById("editTypeId").value=t.id;document.getElementById("tpName").value=t.name||"";document.getElementById("tpPrice").value=t.price||"";document.getElementById("tpCapacity").value=t.capacity||"";openModal("typeModal");}).catch(function(){showToast("Failed to load type","error");});}

async function saveType(){
    var name=document.getElementById("tpName").value.trim();
    if(!name){showToast("Name required","error");return;}
    var body={name:name,price:parseFloat(document.getElementById("tpPrice").value)||0,capacity:parseInt(document.getElementById("tpCapacity").value)||2};
    try{
        var res=await fetch(API+"/rooms/types/",{method:"POST",headers,body:JSON.stringify(body)});
        if(res.ok){showToast("Type created!","success");closeModal("typeModal");renderTypeGrid();}
        else{var d=await res.json();showToast(d.detail||"Failed","error");}
    }catch(e){showToast("Network error","error");}
}

// ==================== OTHER TABS ====================
function renderOccupancy(){
    var tbody=document.getElementById("occBody");
    var occ=rooms.filter(function(r){return r.status==="ACTIVE_STAY";});
    tbody.innerHTML=occ.length?occ.map(function(r){return'<tr><td>Occupied</td><td style="color:#e4af3e;font-weight:700">Room '+r.room_number+'</td><td>'+(r.room_type||"Standard")+'</td><td>—</td><td>—</td><td><button class="btn btn-outline btn-sm">Check-Out</button></td></tr>';}).join(""):'<tr><td colspan="6" style="text-align:center;color:#55556e;padding:40px;">No guests checked in.</td></tr>';
}

function renderQRGrid(){
    var grid=document.getElementById("qrGrid");
    var active=rooms.filter(function(r){return r.status!=="INACTIVE";});
    grid.innerHTML=active.map(function(r){var qid="qr_"+r.id;return'<div class="qr-card"><div class="qr-box" id="'+qid+'"></div><div class="qr-room-label">Room '+r.room_number+'</div><button class="btn btn-gold btn-sm" onclick="genQR(\''+r.id+'\',\''+qid+'\')">Generate</button></div>';}).join("")||'<div class="empty-state"><p>No rooms.</p></div>';
    Object.keys(qrGenerated).forEach(function(rid){var c=document.getElementById("qr_"+rid);if(c&&!c.innerHTML)new QRCode(c,{text:qrGenerated[rid],width:110,height:110,colorDark:"#0d2149",colorLight:"#ffffff",correctLevel:QRCode.CorrectLevel.M});});
}
function genQR(rid,qid){var r=rooms.find(function(x){return x.id===rid;});if(!r)return;var url="https://connect.voddic.com.ng/room/"+r.room_number;qrGenerated[rid]=url;var c=document.getElementById(qid);if(c){c.innerHTML="";new QRCode(c,{text:url,width:110,height:110,colorDark:"#0d2149",colorLight:"#ffffff",correctLevel:QRCode.CorrectLevel.M});}}
function generateAllQRCodes(){rooms.forEach(function(r){genQR(r.id,"qr_"+r.id);});showToast("Done!","success");}

function renderMaintenance(){document.getElementById("maintBody").innerHTML='<tr><td colspan="6" style="text-align:center;color:#55556e;padding:40px;">No records.</td></tr>';}
function renderActivityLog(){document.getElementById("roomLogTimeline").innerHTML='<div class="empty-state"><p>No activity yet.</p></div>';}

// ==================== HELPERS ====================
function openModal(id){document.getElementById(id).classList.add("active");document.body.style.overflow="hidden";}
function closeModal(id){document.getElementById(id).classList.remove("active");if(!document.querySelector(".modal-overlay.active"))document.body.style.overflow="";}
var confirmCallback=null;
function openConfirm(title,desc,cb){document.getElementById("confirmTitle").textContent=title;document.getElementById("confirmDesc").textContent=desc||"";confirmCallback=cb;document.getElementById("confirmAction").onclick=function(){if(confirmCallback)confirmCallback();closeConfirm();};document.getElementById("confirmDialog").classList.add("active");}
function closeConfirm(){document.getElementById("confirmDialog").classList.remove("active");confirmCallback=null;}
function showFieldError(iid,eid){document.getElementById(iid).classList.add("error");document.getElementById(eid).classList.add("visible");}
function clearErrors(){document.querySelectorAll(".form-input.error,.form-error.visible").forEach(function(e){e.classList.remove("error","visible");});}
function showToast(m,t){var d=document.createElement("div");d.className="toast "+(t||"info");d.textContent=m;document.getElementById("toastContainer").appendChild(d);setTimeout(function(){d.remove();},3000);}
function toggleSidebar(){document.getElementById("sidebar").classList.toggle("open");document.getElementById("sidebarOverlay").classList.toggle("active");}
function logout(){localStorage.clear();window.location.href="/auth/login.html";}
document.addEventListener("keydown",function(e){if(e.key==="Escape"){closeConfirm();document.querySelectorAll(".modal-overlay.active").forEach(function(m){closeModal(m.id);});}});
document.querySelectorAll(".modal-overlay").forEach(function(o){o.addEventListener("click",function(e){if(e.target===o)closeModal(o.id);});});
document.getElementById("confirmDialog").addEventListener("click",function(e){if(e.target===this)closeConfirm();});
